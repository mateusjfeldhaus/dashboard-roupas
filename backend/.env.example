# Chave usada como PIN de acesso e para assinar JWTs
API_KEY=seu_pin_aqui

# Secret separado para JWT (opcional — se ausente, usa API_KEY)
JWT_SECRET=um_secret_longo_e_aleatorio

# String de conexão com o banco PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Ambiente
NODE_ENV=development

# Supabase Storage (fotos de looks)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
